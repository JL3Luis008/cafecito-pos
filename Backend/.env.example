# ─── Variables de entorno — Backend Cafecito POS ─────────────────────────────
# Copia este archivo como .env y completa los valores

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production          # 'development' | 'production'
PORT=4000                    # Puerto del servidor Express

# ── Base de datos ─────────────────────────────────────────────────────────────
# Desarrollo local:
#   MONGODB_URI=mongodb://localhost:27017/cafecito_pos
# Producción (MongoDB Atlas):
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cafecito_pos?retryWrites=true&w=majority

# ── Autenticación JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga_en_produccion
# JWT_EXPIRES_IN=30d          # (Opcional) tiempo de expiración del token

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma (sin espacios)
# Desarrollo: http://localhost:3000
# Producción: https://tu-frontend.onrender.com,https://otro-dominio.com
CORS_ORIGIN=http://localhost:3000
